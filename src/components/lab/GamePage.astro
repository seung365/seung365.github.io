---
// 놀이터 게임 페이지 공용 틀: 제목·소개, 검색용 구조화 데이터, 다른 게임 링크
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";
import { LAB_GAMES } from "./games";

interface Props {
	slug: string;
}
const game = LAB_GAMES.find((g) => g.slug === Astro.props.slug);
if (!game) throw new Error(`unknown lab game: ${Astro.props.slug}`);
const others = LAB_GAMES.filter((g) => g.slug !== game.slug);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: game.title,
	headline: game.seoTitle,
	description: game.metaDesc,
	url: new URL(Astro.url.pathname, Astro.site).href,
	image: new URL(`/og/lab-${game.slug}.png`, Astro.site).href,
	applicationCategory: "GameApplication",
	operatingSystem: "Any",
	browserRequirements: "JavaScript 사용",
	inLanguage: "ko-KR",
	isAccessibleForFree: true,
	offers: { "@type": "Offer", price: 0, priceCurrency: "KRW" },
	author: { "@type": "Person", name: "백승범", url: Astro.site },
};
---
<MainGridLayout title={game.seoTitle} description={game.metaDesc} banner={`/og/lab-${game.slug}.png`}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="card-base px-6 md:px-9 py-7 onload-animation">
        <a href={url("/lab/")} class="inline-flex items-center text-sm text-50 hover:text-[var(--primary)] transition mb-4">
            <Icon name="material-symbols:arrow-back-rounded" class="text-lg mr-1"></Icon>놀이터
        </a>
        <div class="text-xs font-bold tracking-[0.2em] text-[var(--primary)] mb-1">{game.kicker}</div>
        <h1 class="text-2xl font-black text-90 mb-1">{game.title}</h1>
        <p class="text-sm text-75 mb-6">{game.desc}</p>
        <slot />
    </div>

    <nav class="card-base px-6 md:px-9 py-6 mt-4 onload-animation" aria-label="다른 놀이">
        <div class="text-sm font-bold text-90 mb-3">다른 놀이</div>
        <div class="grid gap-2 sm:grid-cols-3">
            {others.map((g) => (
                <a href={url(`/lab/${g.slug}/`)} class="flex items-center gap-3 rounded-xl px-3 py-2.5 bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] transition">
                    <Icon name={g.icon} class="text-2xl text-[var(--primary)] shrink-0"></Icon>
                    <span class="min-w-0">
                        <span class="block text-sm font-bold text-90">{g.title}</span>
                        <span class="block text-xs text-50 truncate">{g.kicker}</span>
                    </span>
                </a>
            ))}
        </div>
    </nav>
</MainGridLayout>
