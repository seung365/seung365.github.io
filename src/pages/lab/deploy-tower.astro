---
import { Icon } from "astro-icon/components";
import DeployTower from "../../components/lab/DeployTower.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";
---
<MainGridLayout title="배포 타워" description="블록을 타이밍 맞춰 떨어뜨려 쌓아 올리는 3D 원터치 게임.">
    <div class="card-base px-6 md:px-9 py-7 onload-animation">
        <a href={url("/lab/")} class="inline-flex items-center text-sm text-50 hover:text-[var(--primary)] transition mb-4">
            <Icon name="material-symbols:arrow-back-rounded" class="text-lg mr-1"></Icon>놀이터
        </a>
        <div class="text-xs font-bold tracking-[0.2em] text-[var(--primary)] mb-1">DEPLOY TOWER</div>
        <h1 class="text-2xl font-black text-90 mb-1">배포 타워</h1>
        <p class="text-sm text-75 mb-6">블록을 타이밍 맞춰 떨어뜨려 쌓아 올리는 3D 원터치 게임.</p>
        <DeployTower />
    </div>
</MainGridLayout>
