---
import { Icon } from "astro-icon/components";
import BugHunt from "../../components/lab/BugHunt.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";
---
<MainGridLayout title="버그 잡기" description="30초 동안 에디터 위의 버그를 최대한 많이 잡는 아케이드. 오늘의 챌린지는 모두에게 같은 판이 나와요.">
    <div class="card-base px-6 md:px-9 py-7 onload-animation">
        <a href={url("/lab/")} class="inline-flex items-center text-sm text-50 hover:text-[var(--primary)] transition mb-4">
            <Icon name="material-symbols:arrow-back-rounded" class="text-lg mr-1"></Icon>놀이터
        </a>
        <div class="text-xs font-bold tracking-[0.2em] text-[var(--primary)] mb-1">BUG HUNT</div>
        <h1 class="text-2xl font-black text-90 mb-1">버그 잡기</h1>
        <p class="text-sm text-75 mb-6">30초 동안 에디터 위의 버그를 최대한 많이 잡는 아케이드. 오늘의 챌린지는 모두에게 같은 판이 나와요.</p>
        <BugHunt />
    </div>
</MainGridLayout>
