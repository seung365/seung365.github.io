---
import { Icon } from "astro-icon/components";
import LabBest from "../../components/lab/LabBest.astro";
import ParticleType from "../../components/lab/ParticleType.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";

const games = [
	{
		href: "/lab/bug-hunt/",
		kicker: "ARCADE · 30초",
		title: "버그 잡기",
		desc: "에디터 위를 기어다니는 버그를 잡아라. 크리티컬은 빠르고, 초록 체크는 기능이니 건드리지 말 것.",
		tags: ["오늘의 챌린지", "콤보", "Canvas 2D"],
		icon: "material-symbols:bug-report-rounded",
		best: { key: "bug-hunt", unit: "점" },
	},
	{
		href: "/lab/deploy-tower/",
		kicker: "3D · 원터치",
		title: "배포 타워",
		desc: "움직이는 블록을 타이밍 맞춰 떨어뜨려 쌓아 올리기. 어긋난 만큼 잘려 나간다. 몇 층까지 배포할 수 있을까?",
		tags: ["Three.js", "퍼펙트 연속", "모바일 OK"],
		icon: "material-symbols:stacks-rounded",
		best: { key: "deploy-tower", unit: "층" },
	},
];
---
<MainGridLayout title="놀이터" description="Three.js 실험과 미니게임을 모아둔 놀이터">
    <section class="card-base overflow-hidden mb-4 onload-animation">
        <ParticleType text="PLAYGROUND" class="h-40 md:h-56 w-full" />
        <div class="px-8 md:px-10 pb-8 -mt-2">
            <div class="text-xs font-bold tracking-[0.2em] text-[var(--primary)] mb-2">LAB</div>
            <h1 class="text-3xl font-black text-90 mb-2">놀이터</h1>
            <p class="text-75">
                글 쓰다 쉬어 가는 곳. Three.js 실험과 미니게임을 모아둡니다.
            </p>
        </div>
    </section>

    <div class="grid md:grid-cols-2 gap-4">
        {games.map((g, i) => (
            <a href={url(g.href)} class="card-base group relative flex flex-col p-7 transition hover:-translate-y-1 onload-animation"
               style={`animation-delay: calc(var(--content-delay) + ${(i + 1) * 80}ms)`}>
                <div class="flex items-start justify-between mb-5">
                    <div class="w-14 h-14 rounded-2xl bg-[var(--btn-regular-bg)] text-[var(--primary)] flex items-center justify-center transition group-hover:scale-110 group-hover:-rotate-6">
                        <Icon name={g.icon} class="text-3xl"></Icon>
                    </div>
                    <div class="text-right">
                        <div class="text-[0.65rem] font-bold tracking-[0.15em] text-50">MY BEST</div>
                        <div class="text-sm font-bold text-90"><LabBest gameKey={g.best.key} unit={g.best.unit} /></div>
                    </div>
                </div>
                <div class="text-xs font-bold tracking-[0.15em] text-[var(--primary)] mb-1">{g.kicker}</div>
                <h2 class="text-xl font-bold text-90 mb-2">{g.title}</h2>
                <p class="text-sm text-75 leading-relaxed mb-4 flex-1">{g.desc}</p>
                <div class="flex flex-wrap gap-1.5 mb-5">
                    {g.tags.map((t) => <span class="text-xs rounded-md px-2 py-1 bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">{t}</span>)}
                </div>
                <div class="flex items-center font-bold text-[var(--primary)]">
                    플레이하기
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xl ml-1 transition group-hover:translate-x-1"></Icon>
                </div>
            </a>
        ))}
    </div>
</MainGridLayout>
